pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            steps {
                echo 'Cloning repository...'
                git branch: 'main', url: 'https://github.com/KendyReriani17/e-commerce-pipeline.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image...'
                bat 'docker build -t ecommerce-app .'
            }
        }

        stage('Run Docker Container') {
            steps {
                echo 'Running the Docker container...'
                bat '''
                docker stop ecommerce-app || echo "No running container"
                docker rm ecommerce-app || echo "No existing container"
                docker run -d -p 8000:8000 --name ecommerce-app ecommerce-app
                '''
            }
        }

        stage('Clean Up') {
            steps {
                echo 'Cleaning up unused Docker resources...'
                bat 'docker system prune -f'
            }
        }
    }

    post {
        always {
            echo 'Pipeline finished.'
        }
        success {
            echo 'Pipeline successful!'
        }
        failure {
            echo 'Pipeline failed.'
        }
    }
}
