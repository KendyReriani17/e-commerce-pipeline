pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            steps {
                echo 'Cloning repository...'
                git branch: 'main', url: 'https://github.com/KendyReriani17/e-commerce-pipeline.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                echo 'Building Docker image...'
                sh 'docker build -t ecommerce-app .'
            }
        }

        stage('Run Tests') {
            steps {
                echo 'Running tests...'
                // adjust this depending on your test command
                sh 'docker run --rm ecommerce-app pytest || echo "No tests found"'
            }
        }

        stage('Clean Up') {
            steps {
                echo 'Cleaning up...'
                sh 'docker system prune -f'
            }
        }
    }

    post {
        always {
            echo 'Pipeline successful.'
        }
        failure {
            echo 'Pipeline failed.'
        }
    }
}
